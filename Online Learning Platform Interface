
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SmartLearn - E Learning Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

<!-- Navigation Bar -->
<header>
    <nav class="navbar">
        <h2 class="logo">SmartLearn</h2>

        <ul id="navLinks">
            <li><a href="#home">Home</a></li>
            <li><a href="#categories">Categories</a></li>
            <li><a href="#courses">Courses</a></li>
            <li><a href="#instructors">Instructors</a></li>
            <li><a href="#progress">Progress</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>

        <button class="menu-btn" onclick="toggleMenu()">☰</button>
    </nav>
</header>

<!-- Home Banner -->
<section id="home" class="banner">
    <div class="banner-content">
        <h1>Welcome to SmartLearn</h1>
        <h2>Learn New Skills Anytime, Anywhere</h2>
        <p>Improve your knowledge with our online courses.</p>
        <a href="#courses" class="btn">Explore Courses</a>
    </div>
</section>

<!-- Course Categories -->
<section id="categories">
    <h1 class="heading">Course Categories</h1>

    <div class="container">
        <div class="category">💻 Web Development</div>
        <div class="category">🐍 Python Programming</div>
        <div class="category">🤖 Artificial Intelligence</div>
        <div class="category">📊 Data Science</div>
        <div class="category">🎨 Graphic Design</div>
        <div class="category">📱 Mobile Development</div>
    </div>
</section>

<!-- Courses -->
<section id="courses">
    <h1 class="heading">Popular Courses</h1>

    <div class="container">

        <!-- Course 1 -->
        <div class="course-card">
            <img src="https://placehold.co/600x300/4361ee/ffffff?text=HTML+%26+CSS" alt="HTML and CSS course">
            <div class="course-content">
                <h2>HTML and CSS</h2>
                <p class="description">
                    Learn how to create attractive and responsive websites.
                </p>

                <p><b>Instructor:</b> John Smith</p>
                <p><b>Duration:</b> 8 Weeks</p>

                <h3>Learning Objectives</h3>
                <ul>
                    <li>Learn HTML basics</li>
                    <li>Understand CSS styling</li>
                    <li>Create responsive websites</li>
                </ul>

                <button class="btn enroll-btn" onclick="enroll(this, 'HTML and CSS')">
                    Enroll Now
                </button>
            </div>
        </div>

        <!-- Course 2 -->
        <div class="course-card">
            <img src="https://placehold.co/600x300/14213d/ffffff?text=Python+Programming" alt="Python programming course">
            <div class="course-content">
                <h2>Python Programming</h2>
                <p class="description">
                    Learn Python programming from beginner to advanced level.
                </p>

                <p><b>Instructor:</b> David Kumar</p>
                <p><b>Duration:</b> 10 Weeks</p>

                <h3>Learning Objectives</h3>
                <ul>
                    <li>Understand Python syntax</li>
                    <li>Learn loops and functions</li>
                    <li>Develop Python projects</li>
                </ul>

                <button class="btn enroll-btn" onclick="enroll(this, 'Python Programming')">
                    Enroll Now
                </button>
            </div>
        </div>

        <!-- Course 3 -->
        <div class="course-card">
            <img src="https://placehold.co/600x300/0f766e/ffffff?text=Artificial+Intelligence" alt="Artificial intelligence course">
            <div class="course-content">
                <h2>Artificial Intelligence</h2>
                <p class="description">
                    Explore AI concepts and modern intelligent technologies.
                </p>

                <p><b>Instructor:</b> Priya Sharma</p>
                <p><b>Duration:</b> 12 Weeks</p>

                <h3>Learning Objectives</h3>
                <ul>
                    <li>Understand AI concepts</li>
                    <li>Learn machine learning basics</li>
                    <li>Explore real-world AI applications</li>
                </ul>

                <button class="btn enroll-btn" onclick="enroll(this, 'Artificial Intelligence')">
                    Enroll Now
                </button>
            </div>
        </div>

    </div>
</section>

<!-- Video Lessons -->
<section id="videos">
    <h1 class="heading">Video Lessons</h1>

    <div class="container">

        <div class="video-card">
            <div class="video-thumb">
                <img src="https://placehold.co/600x300/4361ee/ffffff?text=HTML+Lesson+1" alt="HTML introduction lesson">
                <span>▶</span>
            </div>
            <h3>Introduction to HTML</h3>
            <p>Learn the basics of HTML.</p>
            <button class="btn" onclick="playLesson('HTML Introduction')">
                Watch Lesson
            </button>
        </div>

        <div class="video-card">
            <div class="video-thumb">
                <img src="https://placehold.co/600x300/14213d/ffffff?text=CSS+Lesson+2" alt="CSS styling lesson">
                <span>▶</span>
            </div>
            <h3>CSS Styling Basics</h3>
            <p>Learn website styling using CSS.</p>
            <button class="btn" onclick="playLesson('CSS Styling Basics')">
                Watch Lesson
            </button>
        </div>

        <div class="video-card">
            <div class="video-thumb">
                <img src="https://placehold.co/600x300/0f766e/ffffff?text=JavaScript+Lesson+3" alt="JavaScript lesson">
                <span>▶</span>
            </div>
            <h3>JavaScript Basics</h3>
            <p>Learn interactive web development.</p>
            <button class="btn" onclick="playLesson('JavaScript Basics')">
                Watch Lesson
            </button>
        </div>

    </div>

    <p id="lessonMessage"></p>
</section>

<!-- Instructors -->
<section id="instructors">
    <h1 class="heading">Our Instructors</h1>

    <div class="container">

        <div class="instructor-card">
            <img src="https://placehold.co/150x150/4361ee/ffffff?text=John" alt="John Smith">
            <h2>John Smith</h2>
            <p>Web Development Expert</p>
        </div>

        <div class="instructor-card">
            <img src="https://placehold.co/150x150/14213d/ffffff?text=David" alt="David Kumar">
            <h2>David Kumar</h2>
            <p>Python Programming Expert</p>
        </div>

        <div class="instructor-card">
            <img src="https://placehold.co/150x150/0f766e/ffffff?text=Priya" alt="Priya Sharma">
            <h2>Priya Sharma</h2>
            <p>Artificial Intelligence Expert</p>
        </div>

    </div>
</section>

<!-- Learning Progress -->
<section id="progress">
    <h1 class="heading">My Learning Progress</h1>

    <div class="progress-box">

        <h3>HTML and CSS</h3>
        <div class="progress-bar">
            <div class="progress html">75%</div>
        </div>

        <h3>Python Programming</h3>
        <div class="progress-bar">
            <div class="progress python">50%</div>
        </div>

        <h3>Artificial Intelligence</h3>
        <div class="progress-bar">
            <div class="progress ai">30%</div>
        </div>

    </div>
</section>

<!-- Contact -->
<section id="contact">
    <h1 class="heading">Contact Us</h1>

    <div class="contact-box">
        <p>Email: support@smartlearn.com</p>
        <p>Phone: +91 9876543210</p>
        <p>Location: Andhra Pradesh, India</p>

        <form onsubmit="sendMessage(event)">
            <input type="text" placeholder="Enter Your Name" required>
            <input type="email" placeholder="Enter Your Email" required>
            <textarea placeholder="Enter Your Message" required></textarea>
            <button type="submit" class="btn">Send Message</button>
        </form>

        <p id="message"></p>
    </div>
</section>

<!-- Footer -->
<footer>
    <h2>SmartLearn</h2>
    <p>Learn Today, Succeed Tomorrow.</p>
    <p>© 2026 SmartLearn. All Rights Reserved.</p>
</footer>

<script src="script.js"></script>

</body>
</html>

